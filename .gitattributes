*.sh text eol=lf
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
# systemd parses these on Linux and the security gate matches whole lines in
# them. A CRLF working copy on Windows makes every one of those matches fail
# locally while passing in CI, which is the worst way for a check to be wrong.
*.service text eol=lf

# Vendored upstream seccomp profile: embedded byte for byte and pinned by
# hash, so no line-ending conversion may touch it on any platform.
apps/edge-agent/internal/privileged/seccompprofile/** -text
