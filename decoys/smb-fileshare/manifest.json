{
  "schema": "guardian.decoy.manifest.v1",
  "pack": "smb-fileshare",
  "version": "0.1.0",
  "family": "smb",
  "interaction_level": "low",
  "ports": [
    { "port": 139, "protocol": "tcp" },
    { "port": 445, "protocol": "tcp" }
  ],
  "network": { "mode": "routed_secondary_ip" },
  "privileges": { "capabilities": ["NET_BIND_SERVICE"] },
  "telemetry": { "adapter": "smb-audit" },
  "health_probe": { "type": "tcp_connect", "port": 445, "timeout_seconds": 5 },
  "resources": { "cpu_millicores": 250, "memory_mib": 192, "pids": 64 },
  "egress": { "policy": "deny", "allow": [] },
  "persona": {
    "personas": ["windows_file_service_host"],
    "hostname_pattern": "fs-{seq}",
    "banner": "Windows File Service"
  }
}
