{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardianpot.dev/schemas/device/v1/desired-state-snapshot.schema.json",
  "title": "Guardian desired-state snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_id", "revision", "edge_configuration", "zones", "decoys"],
  "properties": {
    "message_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": { "type": "integer", "minimum": 1 },
    "edge_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "environment_id"],
      "properties": {
        "device_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "environment_id": { "type": "string", "format": "uuid" }
      }
    },
    "zones": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["zone_id", "display_name", "cidr", "source_revision"],
        "properties": {
          "zone_id": { "type": "string", "format": "uuid" },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 512 },
          "cidr": { "type": "string", "minLength": 9, "maxLength": 18 },
          "source_revision": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "decoys": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decoy_id",
          "zone_id",
          "display_name",
          "family",
          "persona",
          "interaction_level",
          "address",
          "pack",
          "pack_version",
          "pack_digest",
          "desired_state",
          "source_revision"
        ],
        "properties": {
          "decoy_id": { "type": "string", "format": "uuid" },
          "zone_id": { "type": "string", "format": "uuid" },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 512 },
          "family": { "enum": ["ssh", "http", "postgres", "smb"] },
          "persona": {
            "enum": [
              "linux_admin_server",
              "internal_admin_web_app",
              "database_server",
              "windows_file_service_host"
            ]
          },
          "interaction_level": { "enum": ["low", "medium"] },
          "address": { "type": "string", "minLength": 7, "maxLength": 15 },
          "pack": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "pack_version": { "type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}$" },
          "pack_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "desired_state": { "enum": ["deployed", "disabled"] },
          "source_revision": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
