{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.guardianpot.internal/device/v1/device-identity.schema.json",
  "title": "Guardian Device Identity v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "device_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "contract_version": {
      "const": "guardian.device.v1"
    },
    "certificate_serial": {
      "type": "string",
      "pattern": "^[0-9a-f]{1,32}$"
    },
    "environment_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": ["device_id", "contract_version", "certificate_serial", "environment_id"]
}
