[Unit]
Description=Guardian Edge Privileged Helper
Documentation=file:/usr/share/doc/guardian-edge/privileged-helper.md
After=local-fs.target containerd.service
Before=guardian-edge.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=guardian-edge
ExecStart=/usr/libexec/guardian-edge/guardian-edge-privd
Restart=on-failure
RestartSec=5s
TimeoutStartSec=15s
TimeoutStopSec=10s
KillSignal=SIGTERM
KillMode=mixed
UMask=0077

RuntimeDirectory=guardian-edge-privd
RuntimeDirectoryMode=0750

NoNewPrivileges=yes
# P2-W1: the address adapter changes a host interface through NETLINK_ROUTE, and
# CAP_NET_ADMIN is the whole of what that needs. This line is the capability
# grant in its entirety — the helper runs as root, so the bounding set is what
# actually decides its powers, and everything outside it stays unreachable.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# Already implied by the three directives around it; stated so the profile
# keeps headroom under the exposure ceiling the security gate enforces.
PrivateMounts=yes
# An address has to be added to the host's interface, which cannot be seen from
# a private network namespace. This is the largest single concession in the
# profile and the reason IPAddressDeny and SocketBindDeny below are not
# optional: the helper can see the host's network but cannot speak on it.
PrivateNetwork=no
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ReadOnlyPaths=-/run/containerd/containerd.sock
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
DevicePolicy=closed
# AF_UNIX for the helper's own socket, AF_NETLINK for the address adapter.
# AF_INET, AF_INET6, and AF_PACKET remain unreachable, so the helper can change
# the host's addressing without being able to send a packet.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
IPAddressDeny=any
SocketBindDeny=any
TasksMax=64
LimitNOFILE=1024
LimitCORE=0
OOMPolicy=stop

StandardOutput=journal
StandardError=journal
SyslogIdentifier=guardian-edge-privd

[Install]
WantedBy=multi-user.target
