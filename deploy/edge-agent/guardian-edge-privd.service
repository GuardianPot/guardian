[Unit]
Description=Guardian Edge Privileged Helper
Documentation=file:/usr/share/doc/guardian-edge/privileged-helper.md
After=local-fs.target containerd.service
Before=guardian-edge.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=guardian-edge
ExecStart=/usr/libexec/guardian-edge/guardian-edge-privd
Restart=on-failure
RestartSec=5s
TimeoutStartSec=15s
TimeoutStopSec=10s
KillSignal=SIGTERM
KillMode=mixed
UMask=0077

RuntimeDirectory=guardian-edge-privd
RuntimeDirectoryMode=0750

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ReadOnlyPaths=-/run/containerd/containerd.sock
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
DevicePolicy=closed
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
IPAddressDeny=any
TasksMax=64
LimitNOFILE=1024
LimitCORE=0
OOMPolicy=stop

StandardOutput=journal
StandardError=journal
SyslogIdentifier=guardian-edge-privd

[Install]
WantedBy=multi-user.target
