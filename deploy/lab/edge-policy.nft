table inet guardian_lab {
  chain forward {
    type filter hook forward priority 0; policy drop;
    ct state established,related accept
    ip saddr 172.30.10.0/24 ip daddr 172.30.20.0/24 accept
    ip saddr 172.30.20.0/24 ip daddr 172.30.10.0/24 accept
  }

  chain output {
    type filter hook output priority 0; policy drop;
    ct state established,related accept
    ip daddr 127.0.0.0/8 accept
    ip daddr 172.30.0.0/24 accept
    ip daddr 172.30.10.0/24 accept
    ip daddr 172.30.20.0/24 accept
  }
}
